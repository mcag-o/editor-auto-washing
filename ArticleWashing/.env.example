# =============================
# AI / Provider 密钥
# =============================
# 对应 workspace.yaml 中 provider_profiles.*.secret_ref = env.LLM_API_KEY
LLM_API_KEY=

# 可选：OpenAI 兼容网关地址（如中转网关）
LLM_BASE_URL=

# =============================
# 自动化告警
# =============================
# 可选：自动化告警 webhook 地址
CONTENT_HUB_AUTOMATION_ALERT_WEBHOOK_URL=

# 可选：webhook 冷却时间（秒），会覆盖 workspace.yaml 对应配置
CONTENT_HUB_AUTOMATION_ALERT_WEBHOOK_COOLDOWN_SECONDS=300

# =============================
# 采集器运行参数（DataCollection）
# =============================
# 当运行采集器时会读取这些变量（DataCollection/src/config/env.js）
HTTP_TIMEOUT_MS=10000
HTTP_RETRY_COUNT=2
HTTP_RETRY_BASE_MS=250
GLOBAL_CONCURRENCY=4
DEFAULT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36
# 可选代理
HTTP_PROXY=
HTTPS_PROXY=
# 平台 Cookie（按需填写）
WEIBO_COOKIE=
XUEQIU_COOKIE=
# 是否启用浏览器兜底抓取
ENABLE_BROWSER_FALLBACK=false
