{
  "http": {
    "host": "0.0.0.0",
    "port": 8123,
    "read_timeout_sec": 15,
    "write_timeout_sec": 30,
    "shutdown_timeout_sec": 10
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "driver": "sqlite",
    "path": "./data/content-hub.db",
    "max_open_conns": 10,
    "max_idle_conns": 5,
    "conn_max_life_min": 60
  },
  "storage": {
    "base_path": "./data/storage",
    "max_size_mb": 1024
  },
  "workflow": {
    "max_concurrent_jobs": 5,
    "retry_max_attempts": 3,
    "timeout_sec": 300
  },
  "collector": {
    "defaults": {
      "http_client": "default_api_client",
      "retry_policy": "default_api",
      "auth_profile": "none",
      "timeout_ms": 10000,
      "interval_minutes": 30,
      "hotlist_limit": 50,
      "concurrency": 1
    },
    "http_clients": {},
    "retry_policies": {
      "default_api": {
        "max_attempts": 3,
        "base_wait_ms": 500,
        "max_wait_ms": 5000
      }
    },
    "auth_profiles": {
      "none": {
        "mode": "none"
      },
      "header": {
        "mode": "header",
        "header_name": "Authorization"
      },
      "cookie": {
        "mode": "cookie"
      }
    },
