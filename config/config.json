{
  "http": {
    "host": "0.0.0.0",
    "port": 8123,
    "read_timeout_sec": 15,
    "write_timeout_sec": 30,
    "shutdown_timeout_sec": 10
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "driver": "sqlite",
    "path": "./data/content-hub.db",
    "max_open_conns": 10,
    "max_idle_conns": 5,
    "conn_max_life_min": 60
  },
  "storage": {
    "base_path": "./data/storage",
    "max_size_mb": 1024
  },
  "workflow": {
    "max_concurrent_jobs": 5,
    "retry_max_attempts": 3,
    "timeout_sec": 300
  },
  "secrets": {
    "env_prefix": "CONTENTHUB"
  },
  "llm": {
    "default_profile": "default_openai",
    "profiles": {
      "default_openai": {
        "provider": "openai",
        "api_key_ref": "env.OPENAI_API_KEY",
        "base_url_ref": "env.OPENAI_BASE_URL",
        "model": "gpt-4.1",
        "temperature": 0.7,
        "max_tokens": 4096,
        "timeout_sec": 60
      }
    }
  }
}
